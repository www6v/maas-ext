FROM nvcr.io/nvidia/ai-dynamo/vllm-runtime:with-curand

USER root

# 创建 CUDA include 目录和符号链接
RUN mkdir -p /usr/local/cuda/include && \
    ln -s /usr/local/lib/python3.10/dist-packages/nvidia/cu13/include/curand.h /usr/local/cuda/include/curand.h && \
    ln -s /usr/local/lib/python3.10/dist-packages/nvidia/cu13/include/curand_api.h /usr/local/cuda/include/curand_api.h || true

# 修补 FlashInfer 类型注解
RUN sed -i '1i from __future__ import annotations' \
    /usr/local/lib/python3.10/dist-packages/flashinfer/comm/fd_exchange.py

# 验证
RUN ls -la /usr/local/cuda/include/curand.h && \
    head -2 /usr/local/lib/python3.10/dist-packages/flashinfer/comm/fd_exchange.py && \
    python3 -c "from flashinfer.comm import fd_exchange; print('✓ Import OK')"

ENV CUDA_HOME=/usr/local/cuda
