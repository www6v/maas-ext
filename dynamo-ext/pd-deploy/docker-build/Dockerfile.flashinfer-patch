# 修补 FlashInfer 类型注解问题
FROM nvcr.io/nvidia/ai-dynamo/vllm-runtime:my-tag

USER root

# 修补 fd_exchange.py - 添加 future annotations
RUN sed -i '1i from __future__ import annotations' \
    /usr/local/lib/python3.10/dist-packages/flashinfer/comm/fd_exchange.py && \
    echo "✓ Patched fd_exchange.py" && \
    head -2 /usr/local/lib/python3.10/dist-packages/flashinfer/comm/fd_exchange.py

# 验证修补
RUN python3 -c "from flashinfer.comm import fd_exchange; print('✓ FlashInfer import OK')"

WORKDIR /workspace
CMD ["bash"]
