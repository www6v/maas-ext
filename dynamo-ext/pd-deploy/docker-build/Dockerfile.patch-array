FROM nvcr.io/nvidia/ai-dynamo/vllm-runtime:py311

USER root

# 使用 sed 修补 FlashInfer 的 array.array 类型注解问题
RUN sed -i 's/array\.array\[int\]/array.array/g' \
    /usr/local/lib/python3.11/dist-packages/flashinfer/comm/fd_exchange.py && \
    echo "✓ Patched with sed" && \
    grep "def _fd_ancillary" /usr/local/lib/python3.11/dist-packages/flashinfer/comm/fd_exchange.py

# 验证修补
RUN python3 -c "from flashinfer.comm import fd_exchange; print('✓ Import OK')"
